<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>NeoTimo.XpZ12013.Sdk.DependencyInjection</PackageId>
    <Title>NeoTimo XP Z12-013 SDK — Dependency Injection</Title>
    <Description>Enregistrement Microsoft.Extensions.DependencyInjection pour le SDK NeoTimo XP Z12-013. Paquet séparé pour garder le SDK cœur sans dépendance.</Description>
    <Authors>Avenir Numérique</Authors>
    <Company>Avenir Numérique</Company>
    <PackageTags>afnor;xpz12013;e-invoicing;sdk;dependency-injection</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/neotimo/xpz12013-sdk</PackageProjectUrl>
    <RepositoryUrl>https://github.com/neotimo/xpz12013-sdk.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\XpZ12013.Sdk\XpZ12013.Sdk.csproj" />
  </ItemGroup>

</Project>
