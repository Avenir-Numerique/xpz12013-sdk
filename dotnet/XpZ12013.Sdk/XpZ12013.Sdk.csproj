<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Neotimo.XpZ12013.Sdk</PackageId>
    <Title>Neotimo XP Z12-013 SDK</Title>
    <Description>.NET SDK / implémentation de référence de la norme AFNOR XP Z12-013 v1.3.0 (interopérabilité de la facturation électronique française — Flow Service &amp; Directory Service). Offert par Neotimo / Avenir Numérique.</Description>
    <Authors>Avenir Numérique</Authors>
    <Company>Avenir Numérique</Company>
    <Product>Neotimo XP Z12-013 SDK</Product>
    <PackageTags>afnor;xpz12013;facturation-electronique;e-invoicing;factur-x;pdp;ppf;sdk</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/avenir-numerique/xpz12013-sdk</PackageProjectUrl>
    <RepositoryUrl>https://github.com/avenir-numerique/xpz12013-sdk.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- Aucune dépendance externe : BCL uniquement (HttpClient + System.Text.Json). -->

</Project>
